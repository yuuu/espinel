#!/bin/sh
# Run a command in the ESP-IDF + Spinel container, the project mounted at
# /project:  scripts/idf idf.py build   |   scripts/idf idf.py qemu monitor
set -e
cd "$(dirname "$0")/.."
tty=; [ -t 0 ] && tty=-it
# as the host user, so build/ and sdkconfig stay the user's
exec docker run --rm $tty --user "$(id -u):$(id -g)" -e HOME=/tmp \
  -v "$PWD:/project" -w /project \
  spinel-esp32-idf:v5.5.4 "$@"
