# Settings for every target. The target itself is chosen with
# `rake set-target TARGET=<soc>`; per-target settings go in
# sdkconfig.defaults.<soc>.
# QEMU's OpenCores Ethernet, for running network programs without a board
CONFIG_ETH_USE_OPENETH=y
# termios (io/console's IO#raw and IO#noecho); off by default since v6.0
CONFIG_VFS_SUPPORT_TERMIOS=y
# A 1.5 MB app partition in place of 1 MB (still within 2 MB of flash): a
# program with TLS (Mbed TLS and the certificate bundle) is about 1 MB
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
